# Copy to terraform.tfvars (gitignored) and fill in. CI supplies these same
# values via TF_VAR_* environment variables from GitHub Actions secrets.
tenancy_ocid         = "ocid1.tenancy.oc1..xxx"
user_ocid            = "ocid1.user.oc1..xxx"
fingerprint          = "aa:bb:cc:..."
oci_private_key_path = "/home/you/.oci/oci_api_key.pem"
my_ip_cidr           = "203.0.113.7/32"
ssh_public_key       = "ssh-ed25519 AAAA... you@host"
