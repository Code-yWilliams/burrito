# Secrets come from the "Burrito" 1Password vault (see .env.tpl), the same
# source CI reads via a Service Account. Locally, op authenticates through
# the unlocked 1Password desktop app (app integration) — no token needed.
if timeout 30 op inject -i .env.tpl -o .env.resolved -f; then
  dotenv .env.resolved
else
  log_error "op inject failed — is 1Password unlocked (desktop app integration enabled)?"
fi

# TF_VAR_oci_private_key holds PEM content with embedded newlines, which
# breaks dotenv's single-line KEY="value" parsing even when quoted — read
# it directly instead of routing it through .env.tpl/op inject.
if key=$(timeout 30 op read "op://Burrito/burrito-ci/TF_VAR_oci_private_key" 2>/dev/null); then
  export TF_VAR_oci_private_key="$key"
else
  log_error "op read failed for TF_VAR_oci_private_key — is 1Password unlocked?"
fi
unset key

# OCI's S3-compatible API rejects the AWS SDK's default integrity checksums
# ("AWS chunked encoding not supported"); only send them when required.
export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
